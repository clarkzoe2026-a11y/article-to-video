{"scenes": [{"id": "v1_hook", "title": "钩子", "audio": "audio/v1_hook.wav", "duration": 1.996, "lines": [{"who": "A", "text": "花很多精力，写了一篇文章。", "start": 0.3, "end": 2.081, "chars": [0.3, 0.46, 0.58, 0.7, 0.841, 0.961, 1.001, 1.121, 1.221, 1.241, 1.381, 1.521, 1.541]}]}, {"id": "v2_pain", "title": "痛点", "audio": "audio/v2_pain.wav", "duration": 10.412, "lines": [{"who": "A", "text": "想把它做成视频，让更多人看到：重新录屏、写口播、配音，再把九十三张截图，一张一张对上每一句话。光剪辑，就是好几天。", "start": 0.085, "end": 10.492, "chars": [0.085, 0.225, 0.305, 0.426, 0.546, 0.706, 0.846, 0.866, 1.186, 1.326, 1.486, 1.626, 1.766, 1.947, 2.107, 2.527, 2.827, 3.067, 3.327, 3.668, 3.748, 3.968, 4.228, 4.408, 4.468, 4.688, 5.249, 5.269, 5.349, 5.489, 5.629, 5.749, 5.889, 6.049, 6.249, 6.45, 6.59, 6.83, 7.03, 7.15, 7.35, 7.47, 7.59, 7.69, 7.81, 7.97, 8.171, 8.491, 8.691, 8.891, 9.091, 9.251, 9.371, 9.451, 9.632, 9.732, 9.752]}]}, {"id": "v3_turn", "title": "转折", "audio": "audio/v3_turn.wav", "duration": 2.707, "lines": [{"who": "A", "text": "现在，只要把文章链接，交给我们的工具。", "start": 0.1, "end": 3.102, "chars": [0.1, 0.22, 0.24, 0.64, 0.72, 0.841, 0.981, 1.121, 1.281, 1.461, 1.481, 1.761, 1.921, 2.001, 2.101, 2.182, 2.282, 2.462, 2.682]}]}, {"id": "v4_hero", "title": "变形", "audio": "audio/v4_hero.wav", "duration": 9.598, "lines": [{"who": "A", "text": "它就能读懂你的每一个步骤，写成两个人的对话，讲给观众听；你截图上的每一个红框、每一条命令，都会在讲到它的那一秒出现。", "start": 0.395, "end": 9.283, "chars": [0.395, 0.495, 0.575, 0.735, 0.875, 1.056, 1.156, 1.256, 1.416, 1.536, 1.656, 1.816, 1.936, 2.257, 2.397, 2.617, 2.837, 2.937, 3.037, 3.158, 3.338, 3.358, 3.738, 3.918, 4.058, 4.179, 4.339, 4.539, 4.939, 5.099, 5.26, 5.44, 5.58, 5.66, 5.82, 5.94, 6.1, 6.341, 6.641, 6.661, 6.801, 6.961, 7.121, 7.301, 7.662, 7.682, 7.782, 7.902, 8.062, 8.242, 8.362, 8.463, 8.543, 8.643, 8.743, 8.923, 9.083, 9.263]}]}, {"id": "v5a_steps", "title": "五步（重点）", "audio": "audio/v5a_steps.wav", "duration": 22.566, "lines": [{"who": "A", "text": "五步，文章变视频。第一步，抓取文章：贴上链接，正文和截图一起拿下来。第二步，口播脚本：把文章改写成两个人的对话。第三步，生成配音：整段对话，一次配好。第四步，安排画面：讲到哪张截图，就推近哪个红框。第五步，渲染成片：自动检查，一条命令出片。", "start": 0.205, "end": 22.136, "chars": [0.205, 0.385, 0.565, 0.806, 0.966, 1.146, 1.326, 1.446, 1.466, 2.166, 2.266, 2.346, 2.466, 2.747, 2.887, 2.987, 3.127, 3.287, 3.647, 3.767, 3.907, 4.087, 4.427, 4.447, 4.607, 4.748, 4.868, 5.048, 5.308, 5.468, 5.588, 5.728, 5.848, 6.428, 6.448, 6.528, 6.689, 7.029, 7.049, 7.189, 7.309, 7.489, 7.629, 7.949, 8.089, 8.249, 8.489, 8.649, 8.77, 8.99, 9.19, 9.27, 9.39, 9.49, 9.67, 9.69, 10.35, 10.45, 10.61, 10.63, 10.971, 11.191, 11.351, 11.491, 11.951, 11.971, 12.191, 12.371, 12.551, 12.571, 12.952, 13.132, 13.252, 13.412, 13.552, 14.032, 14.192, 14.332, 14.452, 14.753, 14.913, 15.113, 15.253, 15.753, 15.773, 15.913, 16.073, 16.193, 16.393, 16.553, 16.954, 16.974, 17.194, 17.414, 17.574, 17.694, 17.794, 17.994, 18.174, 18.654, 18.755, 18.895, 18.915, 19.335, 19.515, 19.655, 19.855, 19.875, 20.355, 20.475, 20.655, 20.816, 20.836, 21.316, 21.516, 21.696, 21.836, 21.956, 22.096, 22.116]}]}, {"id": "v5b_gates", "title": "三道关卡", "audio": "audio/v5b_gates.wav", "duration": 6.803, "lines": [{"who": "A", "text": "脚本、配音、成片，这三步你确认了再往下走；哪里不对当场改，不用推倒重来。", "start": 0.23, "end": 6.854, "chars": [0.23, 0.49, 0.651, 0.771, 0.951, 1.131, 1.171, 1.391, 1.551, 1.831, 1.971, 2.151, 2.451, 2.692, 2.912, 3.052, 3.152, 3.252, 3.372, 3.552, 3.692, 4.092, 4.272, 4.412, 4.532, 4.753, 4.953, 5.153, 5.313, 5.473, 5.613, 5.773, 5.893, 6.033, 6.193, 6.353]}]}, {"id": "v6_proof", "title": "证明", "audio": "audio/v6_proof.wav", "duration": 2.272, "lines": [{"who": "A", "text": "一篇图文，变成一支长视频。", "start": 0.051, "end": 2.612, "chars": [0.051, 0.231, 0.411, 0.591, 0.731, 0.991, 1.171, 1.331, 1.411, 1.551, 1.792, 1.932, 2.132]}]}, {"id": "v6b_tag", "title": "标语", "audio": "audio/v6b_tag.wav", "duration": 1.951, "lines": [{"who": "A", "text": "让文章，被看见！", "start": 0.34, "end": 2.301, "chars": [0.34, 0.54, 0.74, 0.92, 1.22, 1.38, 1.601, 1.821]}]}, {"id": "v7_cta", "title": "收尾", "audio": "audio/v7_cta.wav", "duration": 4.097, "